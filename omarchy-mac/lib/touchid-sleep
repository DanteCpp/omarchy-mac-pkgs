#!/bin/bash
# systemd-sleep runs this with "pre" before sleep. Stopping fprintd drops its
# claim on Touch ID, which it keeps across a sleep that starts mid-scan, and
# D-Bus starts it again after resume. Never fails the sleep.
omarchy-hw-apple-silicon || exit 0
[[ ${1:-} == "pre" ]] || exit 0
if systemctl --quiet is-active fprintd.service; then
  timeout 5 systemctl stop fprintd.service || true
  sleep 0.2
fi
exit 0
